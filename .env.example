# Copy to .env.local and fill in real values. See README.md for what each is used for.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# No shared Gemini key — every user must add their own via Profile → Gemini
# API key (BYOK, see lib/gemini/resolveKey.ts). GEMINI_API_KEY_OWNER is the
# one exception: it lets you (OWNER_USER_ID's auth.users id) skip the settings
# UI on your own account. Both keys can come from the same Google account —
# just generate two from aistudio.google.com/apikey for separate quota buckets.
GEMINI_API_KEY_OWNER=
OWNER_USER_ID=

# No shared ElevenLabs key either, same as Gemini above — every user must
# add their own via Profile → ElevenLabs API key (BYOK, see
# lib/elevenlabs/resolveKey.ts) before Speaking Practice's transcription
# will work for them. ELEVENLABS_API_KEY here only benefits OWNER_USER_ID's
# own account, same deal as GEMINI_API_KEY_OWNER.
ELEVENLABS_API_KEY=

# 32 raw bytes, base64-encoded — `openssl rand -base64 32`. Encrypts BYOK
# Gemini/ElevenLabs keys at the application layer before they're stored
# (lib/crypto/secret.ts).
SETTINGS_ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
